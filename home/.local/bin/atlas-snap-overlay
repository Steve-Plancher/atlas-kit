#!/usr/bin/env python3
import json, os, pathlib, subprocess, sys, time

# Minimal overlay implemented as hyprctl notify pulses, deliberately not a heavy always-on compositor layer.
# It gives quick visual section feedback without permanent CPU cost.
ZONES = [
    ('left', 'LEFT 1/2'), ('right', 'RIGHT 1/2'),
    ('third-left', 'LEFT 1/3'), ('third-center', 'CENTER 1/3'), ('third-right', 'RIGHT 1/3'),
    ('top-left', 'TOP LEFT'), ('top-right', 'TOP RIGHT'), ('bottom-left', 'BOTTOM LEFT'), ('bottom-right', 'BOTTOM RIGHT'),
]

def main():
    msg = 'Snap zones: 1/2  •  1/3  •  quarters  |  SUPER+Z opens picker'
    subprocess.run(['hyprctl', 'notify', '1', '3500', 'rgb(00f5ff)', msg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(['notify-send', '-a', 'A.T.L.A.S Snap', 'A.T.L.A.S Snap Zones', msg], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

if __name__ == '__main__':
    main()
